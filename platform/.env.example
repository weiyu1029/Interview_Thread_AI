CAREERPROOF_ENVIRONMENT=development
CAREERPROOF_DATABASE_URL=postgresql+psycopg://careerproof:careerproof@postgres:5432/careerproof
CAREERPROOF_JWT_SECRET=replace-with-at-least-32-random-characters
CAREERPROOF_AUTO_MIGRATE=true
CAREERPROOF_CORS_ORIGINS=["http://localhost:3000"]
CAREERPROOF_DEFAULT_WORKSPACE_PLAN=free

# Optional administrator-approved OpenAI-compatible providers. User-supplied URLs
# are intentionally rejected by the API to prevent server-side request forgery.
CAREERPROOF_PROVIDER_CONFIG_JSON={}

# Optional licensed live-job adapter. Without these values, recommendation and
# market endpoints use imported database records and never present demo data as live.
CAREERPROOF_ADZUNA_APP_ID=
CAREERPROOF_ADZUNA_APP_KEY=
CAREERPROOF_MARKET_PROVIDER_TIMEOUT_SECONDS=12

# Used by the web client when it is connected to the FastAPI service.
NEXT_PUBLIC_CAREERPROOF_API_URL=http://localhost:8000
