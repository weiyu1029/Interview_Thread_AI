# Copy this file to .dev.vars for local development. Never commit real values.
# AUTH_SECRET must be a cryptographically random value of at least 32 characters.
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:3001

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional server-side neural read-aloud. Keep the subscription key private.
# Without both values, interview questions fall back to the browser/device voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Transactional website email. Keep the API key secret and verify the sender
# domain with the provider before using the production address.
RESEND_API_KEY=
EMAIL_FROM=InterviewThread Website <notifications@send.interviewthreadai.com>
EMAIL_FEEDBACK_TO=feedback@interviewthreadai.com
EMAIL_PARTNERSHIPS_TO=partnerships@interviewthreadai.com
